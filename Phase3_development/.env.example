# Phishing Email Detection Tool - Environment Variables
# Copy this file to .env and fill in your values
# NOTE: .env should NOT be committed to git (add to .gitignore)

# Flask Environment
FLASK_ENV=production
DEBUG=False
PORT=5000

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production

# Model artefact paths are now hard-coded in config.py and resolve relative to
# Phase3_development/models/. No environment overrides are required for the
# bundled artefacts. Override only if you serve a different model.
# MODEL_PATH=Phase3_development/models/phishing_model_enhanced.joblib
# TFIDF_VECTORIZER_PATH=Phase3_development/models/tfidf_vectorizer_enhanced.joblib
# SCALER_PATH=Phase3_development/models/scaler_enhanced.joblib

# Decision threshold — overrides config.py if set. Default is 0.35.
# DECISION_THRESHOLD=0.35

# Application Settings
LOG_LEVEL=INFO
