# Phishing Email Detection Tool - Environment Variables
# Copy this file to .env and fill in your values
# NOTE: .env should NOT be committed to git (add to .gitignore)

# Flask Environment
FLASK_ENV=production
DEBUG=False
PORT=5000

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production

# Model Paths (these are relative to the project root)
# Note: In production, ensure these paths are correct for your deployment
MODEL_PATH=../Phase2_development/4_models/phishing_model_phase2.pkl
SCALER_PATH=../Phase2_development/4_models/scaler_phase2.pkl

# Application Settings
LOG_LEVEL=INFO
